# Copy to .env.local and fill in. Never commit .env.local.
# Get values from Supabase → Settings → API.

# Project URL — shown at the top of the API settings page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (the new name for the anon key) — safe to expose client-side.
# Only used if we add Supabase Auth or client-side reads later. Not strictly
# required for MVP since we use the service role on the server.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service role key — NEVER expose client-side. Used by lib/supabase/server.ts
# for trusted reads/writes. Shown under "Service role secret" in API settings;
# reveal then copy.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
